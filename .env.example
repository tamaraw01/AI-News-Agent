# AI News Agent Pro - Environment Configuration

# ==========================================
# REQUIRED API KEYS
# ==========================================

# Groq API (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Google AI (Backup LLM)
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# OPTIONAL API KEYS
# ==========================================

# NewsAPI (for additional news sources)
NEWSAPI_KEY=your_newsapi_key_here

# Reddit API (for Reddit news)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ai-news-agent:v1.0.0

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_ID=0

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/news.db

# Vector Database
CHROMA_PATH=./data/chroma

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ai_news_agent.log

# News Collection
POLL_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_SOURCE=50
MAX_ARTICLES_PER_CYCLE=500
ARTICLE_RETENTION_DAYS=30
ENABLED_COUNTRIES=["us","gb","id","in","au","ca","de","fr","jp","br","za","ng","mx","eg"]
ENABLED_LANGUAGES=["en","id","de","fr","ja","pt","ar","es"]
DAILY_DIGEST_HOUR=7
DAILY_DIGEST_MINUTE=0

# AI Settings
MAX_TOKENS_SUMMARY=300
MAX_TOKENS_ANSWER=500
TEMPERATURE=0.3

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================

# Debug mode
DEBUG=false

# Test mode (uses mock data)
TEST_MODE=false
